# ==============================================================================
# Nexora - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application
APP_NAME=Nexora
APP_COMPANY=Toy BiZ ltd
APP_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
HARDWARE_DEVICE_TOKEN=your-hardware-device-auth-token

# Database (PostgreSQL only)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora

# Initial Super Admin (Bootstrapped only during npm run db:init)
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=use-a-strong-secret
SUPER_ADMIN_ENABLED=true

# Authentication
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=nexora
JWT_AUDIENCE=nexora-application

# Email (SMTP Configuration)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com

# Workforce event protection (Reserved for future module)
WORK_EVENT_COOLDOWN_SECONDS=60

# Supplier links (Reserved for future module)
SUPPLIER_LINK_EXPIRY_HOURS=72
