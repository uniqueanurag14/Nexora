# ==============================================================================
# NEXORA ERP — cPanel / Apache Shared Hosting Configuration (.htaccess)
#
# No root access required. Place in your domain's document root (e.g. ~/public_html).
# Works with cPanel "Setup Node.js App" (Phusion Passenger) OR mod_proxy forwarding.
# ==============================================================================

Options -Indexes -MultiViews
ServerSignature Off

# 1. Block direct web access to dotfiles, secrets, private storage, and source files
<FilesMatch "(^\.env|^\.git|^\.htaccess|package\.json|package-lock\.json|tsconfig\.json|\.sql$|\.enc$|\.ndjson$|\.log$|\.lock$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to private backend directories if co-located inside document root
    RewriteRule ^(server|database|private_backups|private_logs|private_tmp|scripts|tests|deploy|docs)/ - [F,L]

    # 2. Enforce HTTPS across the domain (handles both direct TLS and cPanel proxy)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Optional: Canonicalize www -> apex domain (uncomment and replace abcd.com if desired)
    # RewriteCond %{HTTP_HOST} ^www\.abcd\.com$ [NC]
    # RewriteRule ^ https://abcd.com%{REQUEST_URI} [R=301,L,NE]

    # 3. Forward /api and /uploads to the local Node.js backend ONLY when NOT using cPanel Passenger
    #    (If using cPanel "Setup Node.js App", Passenger automatically injects its own
    #    PassengerAppRoot block into .htaccess — keep the two proxy lines below commented out.)
    # RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L,QSA]
    # RewriteRule ^uploads/(.*)$ http://127.0.0.1:3001/uploads/$1 [P,L,QSA]

    # 4. SPA Fallback Routing (for static dist/ hosting mode when Apache serves dist/ directly)
    #    Routes like /admin, /inventory, /security-center resolve cleanly to index.html.
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/uploads/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# 5. Disable gzip buffering on Server-Sent Events (SSE) streams so live events flush immediately
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "^/api/(events|performance/events/stream|performance/live/stream)" no-gzip=1 dont-vary=1
</IfModule>

# 6. Security & Caching Headers (Defense-in-depth alongside Express headers)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

    # Never cache index.html so new deployments activate immediately
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Long-term immutable cache for Vite hashed JS/CSS bundles
    <FilesMatch "\.(js|css|woff2|svg|png|webp)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>
