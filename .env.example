# ==============================================================================
# NEXORA ERP — Development Environment Configuration Template
# Copy this file to .env for local development.
# For production single-server deployment, use .env.production.example instead.
# ==============================================================================

# Application & Domain
APP_NAME=Nexora
APP_COMPANY=FunZoo Toys
APP_ENV=development
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
API_BASE_URL=/api

# Frontend (Vite Public Variables — NEVER place secrets in VITE_*)
VITE_API_BASE_URL=/api
VITE_APP_NAME=Nexora
VITE_APP_ENV=development

# Backend Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
PORT=3000
REQUEST_BODY_LIMIT=5mb

# Reverse Proxy, CORS & Transport Security
# Allowed values: false | loopback | 1 | 2 | comma-separated trusted proxy IPs/CIDRs
TRUST_PROXY=loopback
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTPS_ONLY=false
SECURE_COOKIES=false
COOKIE_SAMESITE=lax

# PostgreSQL Database (Private local connection)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nexora
PG_POOL_MAX=15
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=3000
PG_STATEMENT_TIMEOUT_MS=15000
PG_SSL=false

# Configurable Runtime Directories (Keep private dirs outside public/ & dist/)
# Database storage is strictly PostgreSQL-only via DATABASE_URL (no JSON file stores)
UPLOADS_DIR=./uploads
TEMP_DIR=./private_tmp
LOGS_DIR=./private_logs

# Initial Super Admin (Bootstrapped only during npm run db:init)
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-dev-password
SUPER_ADMIN_ENABLED=true

# Authentication (Generate 64-char hex via: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=nexora
JWT_AUDIENCE=nexora-application

# Hardware IoT Device Auth Token
HARDWARE_DEVICE_TOKEN=replace-with-hardware-device-token

# Email (SMTP / Nodemailer)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com

# Workforce & Supplier Settings
WORK_EVENT_COOLDOWN_SECONDS=60
SUPPLIER_LINK_EXPIRY_HOURS=72

# ==============================================================================
# Enterprise Security, Audit Logging & Session Hardening
# ==============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
# Dedicated HMAC key for tamper-evident audit hash chaining (separate from JWT_ACCESS_SECRET)
AUDIT_SIGNING_KEY=replace-with-random-64-char-hex-audit-hmac-signing-key

LOGIN_TRACKING_ENABLED=true
DEVICE_TRACKING_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
REQUIRE_ADMIN_MFA=false

# Optional verified enterprise desktop agent shared token
VERIFIED_AGENT_TOKEN=

# Security Alerting (uses configured SMTP / Nodemailer)
SECURITY_ALERT_EMAIL=security-admin@example.com
SECURITY_ALERT_COOLDOWN_MINUTES=10

# API & Auth Rate Limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ==============================================================================
# Encrypted PostgreSQL Database Backups (AES-256-GCM)
# ==============================================================================
DB_BACKUP_ENABLED=true
# Default daily schedule at 02:00 Asia/Kolkata (IST)
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30
# Must reside OUTSIDE public/, dist/, and uploads/ web directories
DB_BACKUP_DIR=./private_backups
# Optional secondary offsite/mounted directory for redundant copy
DB_BACKUP_OFFSITE_DIR=
# Dedicated AES-256-GCM encryption key (64-char hex; NEVER reuse JWT_ACCESS_SECRET)
BACKUP_ENCRYPTION_KEY=replace-with-dedicated-64-char-hex-aes256-backup-key
